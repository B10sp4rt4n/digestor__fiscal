# Default dev (SQLite local)
DB_URL=sqlite:///./local.db
USE_SQLITE=1
API_KEY=change-me-please
TENANT_ID=demo-company
SURVIVAL_ENABLED=1
UPLOAD_DIR=./uploads

# For Postgres (example):
# DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/digestor
# USE_SQLITE=0


# SAT QR online validation flags
SAT_ONLINE_VALIDATION=0
SAT_TIMEOUT=5
SAT_RETRIES=2
SAT_CACHE_TTL=86400  # 1 day in seconds
SAT_ALLOW_LEGACY_TLS=1


# Alert thresholds
ALERT_ERR_RATE=0.05            # 5%
ALERT_BURST_EPM=500            # events per minute
ALERT_P95_LATENCY_MS=5000      # 5 seconds


# Notifications
ALERTS_NOTIFY_SLACK_WEBHOOK=
ALERTS_NOTIFY_WEBHOOK=
ALERTS_AUTOPOLL=0
ALERTS_AUTOPOLL_SECONDS=60
