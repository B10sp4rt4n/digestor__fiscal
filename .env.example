# Neon / Postgres principal
# Puedes usar DB_URL o DATABASE_URL. Si ambas existen, se prioriza DATABASE_URL.
DB_URL=postgresql+psycopg://neondb_owner:REPLACE_ME@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql+psycopg://neondb_owner:REPLACE_ME@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
USE_SQLITE=0
API_KEY=change-me-please
TENANT_ID=demo-company
DEFAULT_USER_ID=local-user
DEFAULT_USER_ROLE=admin
SURVIVAL_ENABLED=1
UPLOAD_DIR=./uploads

# Auth / tenancy
AUTH_CONNECTOR=none
AUTH_ALLOW_ANONYMOUS=1
AUTH_HEADER_TENANT=X-Tenant-Id
AUTH_HEADER_USER=X-User-Id
AUTH_HEADER_ROLE=X-User-Role

# Fallback local opcional
# DB_URL=sqlite:///./local.db
# USE_SQLITE=1

# Postgres / Neon connection options
DB_SSL_REQUIRE=1
DB_POOL_PRE_PING=1
DB_POOL_RECYCLE_SECONDS=1800

# Local backup export
LOCAL_BACKUP_ENABLED=1
LOCAL_BACKUP_DIR=./backups
LOCAL_BACKUP_PRETTY=1
LOCAL_BACKUP_INCLUDE_USERS=0


# SAT QR online validation flags
SAT_ONLINE_VALIDATION=0
SAT_TIMEOUT=5
SAT_RETRIES=2
SAT_CACHE_TTL=86400  # 1 day in seconds
SAT_ALLOW_LEGACY_TLS=1


# Alert thresholds
ALERT_ERR_RATE=0.05            # 5%
ALERT_BURST_EPM=500            # events per minute
ALERT_P95_LATENCY_MS=5000      # 5 seconds


# Notifications
ALERTS_NOTIFY_SLACK_WEBHOOK=
ALERTS_NOTIFY_WEBHOOK=
ALERTS_AUTOPOLL=0
ALERTS_AUTOPOLL_SECONDS=60

# OpenAI (validación IA por campo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_FIELD_VALIDATION_ENABLED=0
AI_FIELD_VALIDATION_AUTO_APPLY=0
AI_FIELD_VALIDATION_MIN_CONFIDENCE=0.85

# PAC / TimbraCFDI
# Mientras el PAC no active producción, usa sandbox.
TIMBRACFDI_ENV=sandbox
TIMBRACFDI_BASE_URL=https://pruebas.timbracfdi33.mx:1444/api/v2
TIMBRACFDI_TOKEN=
TIMBRACFDI_SANDBOX_BASE_URL=https://pruebas.timbracfdi33.mx:1444/api/v2
TIMBRACFDI_SANDBOX_TOKEN=
TIMBRACFDI_PRODUCTION_BASE_URL=
TIMBRACFDI_PRODUCTION_TOKEN=
TIMBRACFDI_TIMEOUT=45
TIMBRACFDI_EMIT_OFFSET_HOURS=5
TIMBRACFDI_DEMO_ENABLED=1

# Developer-led
DEVELOPER_PORTAL_ENABLED=1
DEVELOPER_SANDBOX_ENABLED=1
DEVELOPER_SANDBOX_TENANT_PREFIX=sandbox
DEVELOPER_SANDBOX_USERNAME_PREFIX=dev
DEVELOPER_SANDBOX_DEFAULT_ROLE=operator
DEVELOPER_SANDBOX_TOKEN_EXPIRE_MINUTES=1440
