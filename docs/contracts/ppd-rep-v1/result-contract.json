{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cotiza:digestor:rep-result:1",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "rep-result/1.0"
    },
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "prepared",
        "processing",
        "unknown",
        "rejected",
        "failed_local",
        "stamped",
        "quarantined"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "retryable": {
      "type": "boolean"
    },
    "next_action": {
      "enum": [
        "wait",
        "review",
        "authorize_retry",
        "none"
      ]
    },
    "request_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "last_event_id": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_document": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string",
              "format": "uuid"
            },
            "xml_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "protected_xml_ref": {
              "type": "string",
              "minLength": 1
            },
            "confirmed_applications": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "income_uuid": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "cash_application_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "partiality": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "previous_balance": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
                  },
                  "paid": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
                  },
                  "remaining_balance": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
                  },
                  "fiscal_revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "income_uuid",
                  "cash_application_id",
                  "partiality",
                  "previous_balance",
                  "paid",
                  "remaining_balance",
                  "fiscal_revision"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "uuid",
            "xml_sha256",
            "protected_xml_ref",
            "confirmed_applications"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "intent_id",
    "revision",
    "status",
    "attempt",
    "retryable",
    "next_action",
    "request_hash",
    "last_event_id",
    "confirmed_document"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "stamped"
          }
        }
      },
      "then": {
        "properties": {
          "confirmed_document": {
            "type": "object"
          },
          "retryable": {
            "const": false
          },
          "next_action": {
            "const": "none"
          }
        }
      },
      "else": {
        "properties": {
          "confirmed_document": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "processing",
              "unknown",
              "quarantined"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "retryable": {
            "const": false
          }
        }
      }
    }
  ]
}
